# ==============================================================================
# PromptLens Production Environment Configuration Template
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
TARGET_BASE_URL=https://api.anthropic.com

# Production Security & Access Control
# Optional: set this to require authentication for sensitive control endpoints (/api/settings, /api/vault/clear, /api/stats/reset)
PROMPTLENS_API_KEY=

# SSL Verification (default: true). Never disable in production environments.
PROMPTLENS_SSL_VERIFY=true

# Request Body Limit (default: 52428800 bytes = 50 MB)
MAX_PAYLOAD_BYTES=52428800

# Persistent SQLite Vault Configuration
# Storage backend: 'sqlite' (durable across restarts) or 'memory' (ephemeral)
PROMPTLENS_VAULT_BACKEND=sqlite
PROMPTLENS_VAULT_DB=data/vault.db

# Agent Discipline Ruleset: 'off', 'lite', 'full', 'ultra'
AGENT_DISCIPLINE_MODE=off

# Logging Level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Optional Upstream Cloud API Keys (for live evaluation & proxy passthrough)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
